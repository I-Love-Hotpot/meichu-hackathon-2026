{
  "openapi": "3.0.3",
  "info": {
    "title": "CloudPhone Widget Backend API",
    "version": "v1.4.0",
    "description": "API for the backend of the custom CloudPhone widget."
  },
  "servers": [
    {
      "url": "/",
      "description": "目前開啟 Swagger 的 API 伺服器（支援本機及遠端連接埠轉送）"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Service status",
        "operationId": "getServiceStatus",
        "responses": {
          "200": {
            "description": "Service is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceStatus"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sms/test": {
      "post": {
        "summary": "Send a test SMS",
        "description": "Temporary endpoint. It is registered only when ENABLE_TEST_SMS_ENDPOINT=true. The Twilio account is a trial account, so it always sends the predefined `sms_appointment_reminders` template body; a custom `body` is not accepted.",
        "operationId": "sendTestSms",
        "x-enabled-by": "ENABLE_TEST_SMS_ENDPOINT=true",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestSmsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SMS accepted by Twilio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestSmsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid recipient or message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Twilio failed to send the SMS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Twilio is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/medicine/chat": {
      "post": {
        "tags": [
          "Medicine"
        ],
        "summary": "Medicine questions and recognition-data explanation",
        "operationId": "chatWithMedicineAssistant",
        "description": "Accepts questions in any language and always returns user-facing response text in American English (en-US). Searches 42_2.csv first. A single matching record is translated to English with Google Cloud Translation and supplied to Gemini. Multiple candidates require selection; no match returns an explicit response without calling Gemini. The dataset contains names, license identifiers, and appearance data, but no dosage, indications, or adverse effects.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MedicineChatRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Basic question",
                  "value": {
                    "message": "What color is CHENG KONG PILL?",
                    "history": []
                  }
                },
                "recognition": {
                  "summary": "Recognition-data explanation",
                  "value": {
                    "message": "Please explain this recognition result.",
                    "recognition": {
                      "text": "CHENG KONG PILL",
                      "medications": [
                        {
                          "name": "CHENG KONG PILL",
                          "confidence": 0.82
                        }
                      ]
                    },
                    "history": []
                  }
                },
                "selected": {
                  "summary": "Question about a selected medicine",
                  "value": {
                    "message": "What are its shape, color, and score line?",
                    "selectedMedicineId": "med_5YWn6KGb5oiQ6KO95a2X56ysMDAwMzg26Jmf",
                    "history": []
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Medicine assistant response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MedicineChatResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or conversation-history order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "JSON request exceeds 256 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Content type must be application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Gemini safety filtering prevented a response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Gemini or Translation API rate/quota limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Gemini or Translation API connection/response error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "CSV missing/invalid, or Gemini/Translation API is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Gemini or Translation API timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "selectedMedicineId is not in the dataset",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/medicine/search": {
      "get": {
        "tags": [
          "Medicine"
        ],
        "summary": "Search medicines in the CSV",
        "operationId": "searchMedicines",
        "description": "Searches by English/Chinese name or license identifier, translates Chinese fields to English with Google Cloud Translation, and returns up to 8 records. total is the full match count. Empty fields mean the source did not provide a value. Requires GOOGLE_TRANSLATE_API_KEY when matched records contain Chinese text.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200,
              "pattern": "\\S.*\\S",
              "description": "English/Chinese medicine name or license identifier; partial matching is supported."
            },
            "example": "PANADOL"
          }
        ],
        "responses": {
          "200": {
            "description": "Search results translated to English",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MedicineSearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid search text",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Translation API rate or quota limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Translation API connection or response error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "CSV or Translation API is unavailable or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Translation API timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/medicine/recognize": {
      "post": {
        "tags": [
          "Medicine"
        ],
        "summary": "Recognize medicine candidates with the local model",
        "operationId": "recognizeMedicineImage",
        "description": "Accepts one raw JPEG, PNG, or WebP image of at most 5 MiB. The backend forwards it to the separate pill-inference container over the private Docker network. That service returns only a pill_id array containing up to three six-digit numeric classifier IDs. The backend uses each ID to query MariaDB and returns every column from each matching medicines row in medicines.",
        "requestBody": {
          "required": true,
          "content": {
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary",
                "maxLength": 5242880
              }
            },
            "image/png": {
              "schema": {
                "type": "string",
                "format": "binary",
                "maxLength": 5242880
              }
            },
            "image/webp": {
              "schema": {
                "type": "string",
                "format": "binary",
                "maxLength": 5242880
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Local-model candidates and their MariaDB medicine records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MedicineImageRecognitionResponse"
                }
              }
            }
          },
          "400": {
            "description": "The image is empty or its bytes do not match the declared format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Image exceeds 5 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Content type is not image/jpeg, image/png, or image/webp",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The local recognizer failed or returned invalid output",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "The local recognizer, model, CSV, or MariaDB is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "The local recognizer timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/medicine": {
      "get": {
        "tags": [
          "Medicine"
        ],
        "summary": "依許可證字號查詢藥品資訊（MariaDB）",
        "operationId": "getMedicineByLicenseNumber",
        "description": "提供完整的 license_number，從 MariaDB 的 medicines 資料表查詢對應藥品，並回傳該資料列的所有欄位。\n\n使用完整字號比對，不支援部分字號搜尋；輸入前後空白會移除。資料保留資料庫原始內容，不呼叫翻譯或 Gemini。空字串與 null 代表未提供資料，尺寸未註明單位，多個值或圖片連結保留 ;;; 分隔符號。若資料庫有重複許可證字號，回傳 id 最小的一筆。",
        "parameters": [
          {
            "name": "license_number",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "\\S",
              "description": "藥品完整許可證字號，例如「內衛成製字第000386號」。必填，最多 255 個字元，不可為空白或重複傳入；輸入前後空白會移除。"
            },
            "example": "內衛成製字第000386號",
            "description": "藥品完整許可證字號，例如「內衛成製字第000386號」。必填，最多 255 個字元，不可為空白或重複傳入；輸入前後空白會移除。"
          }
        ],
        "responses": {
          "200": {
            "description": "查詢成功，medicine 包含 MariaDB 對應資料列的所有欄位。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MedicineLookupResponse"
                },
                "example": {
                  "ok": true,
                  "medicine": {
                    "id": 2,
                    "license_number": "內衛成製字第000386號",
                    "chinese_name": "建功丸",
                    "english_name": "CHENG KONG PILL",
                    "shape": "其他",
                    "dosage_form": "",
                    "color": "棕",
                    "odor": "",
                    "score_line": "無",
                    "size": "8",
                    "imprint_1": "",
                    "imprint_2": "",
                    "image_url": "https://mcp.fda.gov.tw/insert/shapeImg/89db57ae-5c85-47b8-9d74-351ecad719e6?c=o",
                    "created_at": "2026-09-19T16:58:24.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "查詢參數錯誤：未提供、空白、超過 255 字元、重複傳入 license_number，或含有其他查詢參數。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "ok": false,
                  "error": "Provide a non-empty license_number of at most 255 characters."
                }
              }
            }
          },
          "404": {
            "description": "查無此許可證字號對應的藥品。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "ok": false,
                  "error": "Medicine not found."
                }
              }
            }
          },
          "503": {
            "description": "資料庫連線或查詢失敗，請稍後再試。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "ok": false,
                  "error": "The medicine database is temporarily unavailable."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ServiceStatus": {
        "type": "object",
        "required": [
          "ok",
          "message",
          "service",
          "timestamp"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "service": {
            "type": "string",
            "example": "cloudphone-backend"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "ok",
          "service",
          "timestamp"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "service": {
            "type": "string",
            "example": "cloudphone-backend"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TestSmsRequest": {
        "type": "object",
        "required": [
          "to"
        ],
        "properties": {
          "to": {
            "type": "string",
            "example": "+886965876576"
          }
        },
        "description": "The Twilio trial account always sends the predefined `sms_appointment_reminders` template body; a custom `body` field is not accepted."
      },
      "TestSmsResponse": {
        "type": "object",
        "required": [
          "ok",
          "sid",
          "status",
          "to"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "sid": {
            "type": "string",
            "example": "SMxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
          },
          "status": {
            "type": "string",
            "example": "queued"
          },
          "to": {
            "type": "string",
            "example": "+886912345678"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "MedicineChatMessage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000,
            "pattern": "\\S"
          }
        }
      },
      "MedicineRecognition": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000,
            "pattern": "\\S",
            "description": "Unverified OCR or recognition text from a medicine package."
          },
          "medications": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "\\S"
                },
                "strength": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "\\S"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Recognition-model score; this does not verify identity."
                }
              }
            }
          }
        },
        "anyOf": [
          {
            "required": [
              "text"
            ]
          },
          {
            "required": [
              "medications"
            ]
          }
        ]
      },
      "MedicineChatRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S",
            "description": "The user's current question."
          },
          "history": {
            "type": "array",
            "maxItems": 20,
            "description": "Up to 10 successful recent turns, starting with user and ending with assistant in complete alternating pairs. The server does not store conversations.",
            "items": {
              "$ref": "#/components/schemas/MedicineChatMessage"
            }
          },
          "recognition": {
            "$ref": "#/components/schemas/MedicineRecognition"
          },
          "selectedMedicineId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "The opaque recordId from a search or recognition result. The backend reloads the source record and does not accept client-supplied medicine fields. This takes priority over automatic matching."
          }
        }
      },
      "MedicineAnswer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "answer",
          "warnings",
          "followUpQuestions"
        ],
        "properties": {
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S",
            "description": "Answer in American English (en-US), regardless of the input language."
          },
          "warnings": {
            "type": "array",
            "maxItems": 5,
            "description": "Warnings in American English (en-US).",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "\\S"
            }
          },
          "followUpQuestions": {
            "type": "array",
            "maxItems": 3,
            "description": "Clarifying questions in American English (en-US).",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            }
          }
        }
      },
      "MedicineChatResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "pill_id",
          "model",
          "reply",
          "disclaimer",
          "sources",
          "catalog"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "model": {
            "type": "string",
            "nullable": true,
            "description": "Null when no record or multiple candidates are found and Gemini is not called."
          },
          "reply": {
            "$ref": "#/components/schemas/MedicineAnswer"
          },
          "disclaimer": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/MedicineRecord"
            },
            "description": "CSV fields retrieved by the backend and translated to English; these are not generated by Gemini."
          },
          "catalog": {
            "$ref": "#/components/schemas/MedicineCatalogContext"
          }
        }
      },
      "MedicineRecord": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recordId": {
            "type": "string",
            "description": "Stable source identifier used as selectedMedicineId. Treat this as an opaque value."
          },
          "licenseNumber": {
            "type": "string",
            "description": "License identifier translated for English display. Use recordId, not this display value, as selectedMedicineId."
          },
          "displayName": {
            "type": "string",
            "description": "English display name: the source English name when present, otherwise a Google translation of the Chinese name."
          },
          "englishName": {
            "type": "string",
            "description": "Source English name; empty means not provided."
          },
          "shape": {
            "type": "string",
            "description": "Shape translated to English; empty means not provided."
          },
          "dosageForm": {
            "type": "string",
            "description": "Special dosage form translated to English; empty means not provided."
          },
          "color": {
            "type": "string",
            "description": "Color translated to English; empty means not provided."
          },
          "odor": {
            "type": "string",
            "description": "Special odor translated to English; empty means not provided."
          },
          "scoreLine": {
            "type": "string",
            "description": "Score-line information translated to English; empty means not provided."
          },
          "size": {
            "type": "string",
            "description": "Appearance size. The source provides no unit; empty means not provided."
          },
          "imprint1": {
            "type": "string",
            "description": "Imprint 1 translated when needed; empty means not provided."
          },
          "imprint2": {
            "type": "string",
            "description": "Imprint 2 translated when needed; empty means not provided."
          },
          "imageUrl": {
            "type": "string",
            "description": "Source appearance-image URL. The image is not read by the assistant; empty means not provided."
          }
        },
        "required": [
          "recordId",
          "licenseNumber",
          "displayName",
          "englishName",
          "shape",
          "dosageForm",
          "color",
          "odor",
          "scoreLine",
          "size",
          "imprint1",
          "imprint2",
          "imageUrl"
        ]
      },
      "MedicineCatalogContext": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fileName": {
            "type": "string",
            "enum": [
              "42_2.csv"
            ]
          },
          "recordCount": {
            "type": "integer",
            "minimum": 0
          },
          "matchedCount": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "matched",
              "ambiguous",
              "not_found"
            ]
          }
        },
        "required": [
          "fileName",
          "recordCount",
          "matchedCount",
          "status"
        ]
      },
      "MedicineSearchQuery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "q": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200,
            "pattern": "\\S.*\\S",
            "description": "English/Chinese medicine name or license identifier; partial matching is supported."
          }
        },
        "required": [
          "q"
        ]
      },
      "MedicineSearchResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "query": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "42_2.csv"
            ]
          },
          "records": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/MedicineRecord"
            }
          },
          "total": {
            "type": "integer"
          },
          "recordCount": {
            "type": "integer"
          }
        },
        "required": [
          "ok",
          "query",
          "source",
          "records",
          "total",
          "recordCount"
        ]
      },
      "MedicineImageRecognitionEvidence": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "medications",
          "pills"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 6000,
            "description": "Visible OCR text copied from the image; empty when no text is legible. This is unverified transcription, not confirmed medicine identity."
          },
          "medications": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "Medicine name directly legible in the image. It is considered for matching only when it also occurs in text."
                },
                "strength": {
                  "type": "string",
                  "maxLength": 100,
                  "description": "Strength directly legible near the medicine name; empty when none is legible."
                }
              }
            }
          },
          "pills": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "imprint"
              ],
              "properties": {
                "imprint": {
                  "type": "string",
                  "maxLength": 100,
                  "description": "Characters directly visible on one pill side; empty when none are legible."
                },
                "color": {
                  "type": "string",
                  "maxLength": 100,
                  "description": "Observed color, or empty when unclear; never sufficient for matching by itself."
                },
                "shape": {
                  "type": "string",
                  "maxLength": 100,
                  "description": "Observed shape, or empty when unclear; never sufficient for matching by itself."
                }
              }
            }
          }
        }
      },
      "MedicineImageRecognitionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "pill_id",
          "model",
          "recognition",
          "matchStrategy",
          "source",
          "records",
          "medicines",
          "total",
          "recordCount",
          "inference"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "pill_id": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "pattern": "^[0-9]{6}$"
            },
            "description": "Six-digit numeric IDs returned by the classifier."
          },
          "model": {
            "type": "string",
            "description": "Local .pt model filename."
          },
          "recognition": {
            "$ref": "#/components/schemas/MedicineImageRecognitionEvidence"
          },
          "matchStrategy": {
            "type": "string",
            "enum": [
              "appearance",
              "none"
            ],
            "description": "appearance when the local classifier returned numeric pill IDs; none when no candidate was found."
          },
          "source": {
            "type": "string",
            "enum": [
              "MariaDB"
            ]
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MedicineRecord"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of complete MariaDB rows returned."
          },
          "recordCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of candidate IDs returned by the local model."
          },
          "medicines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MedicineDatabaseRecord"
            },
            "description": "Complete MariaDB rows matching the numeric classifier IDs."
          },
          "inference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pill_id"
            ],
            "properties": {
              "pill_id": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9]{6}$"
                }
              }
            },
            "description": "Exact JSON returned by the separate inference container."
          }
        }
      },
      "MedicineLookupQuery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "license_number"
        ],
        "properties": {
          "license_number": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "\\S",
            "description": "藥品完整許可證字號，例如「內衛成製字第000386號」。必填，最多 255 個字元，不可為空白或重複傳入；輸入前後空白會移除。"
          }
        }
      },
      "MedicineDatabaseRecord": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "license_number",
          "chinese_name",
          "english_name",
          "shape",
          "dosage_form",
          "color",
          "odor",
          "score_line",
          "size",
          "imprint_1",
          "imprint_2",
          "image_url",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "藥品編號，對應資料表 medicines.id。",
            "example": 2
          },
          "license_number": {
            "type": "string",
            "description": "許可證字號。",
            "example": "內衛成製字第000386號"
          },
          "chinese_name": {
            "type": "string",
            "nullable": true,
            "description": "中文藥名。",
            "example": "建功丸"
          },
          "english_name": {
            "type": "string",
            "nullable": true,
            "description": "英文藥名。",
            "example": "CHENG KONG PILL"
          },
          "shape": {
            "type": "string",
            "nullable": true,
            "description": "形狀。",
            "example": "其他"
          },
          "dosage_form": {
            "type": "string",
            "nullable": true,
            "description": "特殊劑型。",
            "example": ""
          },
          "color": {
            "type": "string",
            "nullable": true,
            "description": "顏色。",
            "example": "棕"
          },
          "odor": {
            "type": "string",
            "nullable": true,
            "description": "特殊氣味。",
            "example": ""
          },
          "score_line": {
            "type": "string",
            "nullable": true,
            "description": "切線／刻痕。",
            "example": "無"
          },
          "size": {
            "type": "string",
            "nullable": true,
            "description": "外觀尺寸，保留來源文字；來源未註明單位。",
            "example": "8"
          },
          "imprint_1": {
            "type": "string",
            "nullable": true,
            "description": "標註一。",
            "example": ""
          },
          "imprint_2": {
            "type": "string",
            "nullable": true,
            "description": "標註二。",
            "example": ""
          },
          "image_url": {
            "type": "string",
            "nullable": true,
            "description": "圖片連結；多個連結保留來源的 ;;; 分隔符號。",
            "example": "https://mcp.fda.gov.tw/insert/shapeImg/89db57ae-5c85-47b8-9d74-351ecad719e6?c=o"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "資料列建立時間。",
            "example": "2026-09-19T16:58:24.000Z"
          }
        },
        "description": "MariaDB medicines 資料表中的藥品原始資訊；欄位名稱與資料庫一致。"
      },
      "MedicineLookupResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "medicine"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "查詢成功時為 true。"
          },
          "medicine": {
            "$ref": "#/components/schemas/MedicineDatabaseRecord"
          }
        }
      }
    }
  }
}
