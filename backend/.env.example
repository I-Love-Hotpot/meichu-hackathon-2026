PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=backend
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ENABLE_TEST_SMS_ENDPOINT=false
# Used by both medicine chat and raw-image medicine recognition.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_SYSTEM_PROMPT="You are the MedCompanion medicine data assistant. Understand questions in any language, but always answer in clear American English (en-US) using only the CSV fields supplied by the backend."
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_TIMEOUT_MS=15000
# Optional override; empty uses backend/resources/42_2.csv bundled with the app.
MEDICINE_CSV_PATH=
MEDICINE_INFERENCE_URL=http://chia.dstw.dev
MEDICINE_RECOGNIZER_TIMEOUT_MS=30000
