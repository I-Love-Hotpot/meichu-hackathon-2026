# Backend
PORT=3001
ALLOWED_ORIGINS=*
# Database
# Docker Compose overrides DB_HOST and DB_PORT for the backend container.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=backend
# SMS
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# Temporary test endpoint; keep false in production.
ENABLE_TEST_SMS_ENDPOINT=false
# Frontend
# Public backend used by the browser. Set this to an empty value to use the
# local Vite proxy or the production Nginx same-origin proxy instead.
VITE_API_BASE_URL=https://api.mc.dstw.dev
# Gemini medicine assistant (server-side only)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_TIMEOUT_MS=30000
GEMINI_SYSTEM_PROMPT="You are the MedCompanion medicine data assistant. Understand questions in any language, but always answer in clear American English (en-US) using only the CSV fields supplied by the backend."
# Google Cloud Translation Basic v2 API key (server-side only).
GOOGLE_TRANSLATE_API_KEY=""
GOOGLE_TRANSLATE_TIMEOUT_MS=15000
# Optional override; empty uses resources/42_2.csv bundled with the app.
MEDICINE_CSV_PATH="resources/42_2.csv"
# Optional override; empty uses the inference package bundled with the backend.
MEDICINE_RECOGNIZER_SCRIPT=""
MEDICINE_RECOGNIZER_PYTHON="python3"
MEDICINE_RECOGNIZER_TIMEOUT_MS=30000
